{
  "name": "liquor-shiiii",
  "version": "1.0.0",
  "description": "WhatsApp enquiry bot for Delhi liquor stores",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "prisma db push --skip-generate && tsx prisma/seed.ts --if-empty && tsx src/server.ts",
    "setup": "prisma db push && tsx --env-file=.env prisma/seed.ts",
    "import": "tsx --env-file-if-exists=.env src/import.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc",
    "link-whatsapp": "tsx --env-file-if-exists=.env src/link.ts",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazimmakesmusic-commits/LIQUOR-SHIIII.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hazimmakesmusic-commits/LIQUOR-SHIIII/issues"
  },
  "homepage": "https://github.com/hazimmakesmusic-commits/LIQUOR-SHIIII#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
